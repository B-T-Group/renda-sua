{
  "name": "agent-mobile",
  "version": "1.0.11",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "dev": "cross-env EXPO_PUBLIC_ENV=dev expo start",
    "prod": "cross-env EXPO_PUBLIC_ENV=prod expo start",
    "start:clear": "expo start --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "run:android": "expo run:android",
    "run:android:device": "bash scripts/run-android-with-adb-serial.sh",
    "android:prebuild": "expo prebuild --platform android",
    "android:assemble-release": "cd android && ./gradlew assembleRelease",
    "android:apk:local": "yarn android:prebuild && yarn android:assemble-release",
    "android:run:release": "expo run:android --variant release",
    "run:ios": "expo run:ios",
    "web": "expo start --web",
    "web:local": "cross-env EXPO_PUBLIC_API_URL=http://localhost:3000/api expo start --web",
    "update": "npx expo install --fix",
    "update:sdk": "npx expo install --fix",
    "sdk": "npx expo install --fix",
    "doctor": "npx expo-doctor",
    "test": "vitest run",
    "ci:test": "vitest run",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "typecheck": "tsc --noEmit",
    "deploy:ota:prod": "yarn update:publish && yarn update:publish:android-aab",
    "prebuild": "expo prebuild",
    "build:android": "eas build --platform android --profile production",
    "build:android:apk": "eas build --platform android --profile production",
    "build:android:aab": "eas build --platform android --profile production-aab",
    "build:ios": "eas build --platform ios --profile production",
    "build:all": "eas build --platform all --profile production",
    "submit:android": "eas submit --platform android --profile production --latest",
    "submit:ios": "eas submit --platform ios --profile production --latest",
    "push:send": "expo push:send",
    "update:publish": "eas update --branch production --platform ios --message \"OTA update\"",
    "update:publish:android-aab": "eas update --branch production-aab --platform android --message \"OTA update (Android Play)\"",
    "update:publish:dev": "eas update --branch development --message \"OTA update (dev)\"",
    "deploy-dev": "bash scripts/merge-main-into-prod.sh"
  },
  "dependencies": {
    "@apollo/client": "^3.11.0",
    "@expo/vector-icons": "^15.0.2",
    "@lottiefiles/dotlottie-react": "^0.19.5",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "@stripe/stripe-react-native": "0.63.0",
    "country-state-city": "^3.2.1",
    "expo": "~55.0.26",
    "expo-auth-session": "~55.0.16",
    "expo-clipboard": "~55.0.13",
    "expo-constants": "~55.0.7",
    "expo-crypto": "~55.0.15",
    "expo-dev-client": "~55.0.35",
    "expo-device": "~55.0.17",
    "expo-document-picker": "~55.0.13",
    "expo-image-picker": "~55.0.20",
    "expo-local-authentication": "~55.0.8",
    "expo-localization": "~55.0.15",
    "expo-location": "~55.1.10",
    "expo-notifications": "~55.0.23",
    "expo-secure-store": "~55.0.8",
    "expo-task-manager": "~55.0.16",
    "expo-updates": "~55.0.24",
    "expo-web-browser": "~55.0.16",
    "graphql": "^16.9.0",
    "graphql-ws": "^6.0.8",
    "i18next": "^23.16.0",
    "libphonenumber-js": "^1.13.1",
    "lottie-react-native": "~7.3.4",
    "mobx": "^6.13.0",
    "mobx-react-lite": "^4.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-i18next": "^15.0.0",
    "react-native": "0.83.6",
    "react-native-edge-to-edge": "^1.8.1",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-paper": "^5.15.2",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.1.1",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "babel-preset-expo": "~55.0.0",
    "cross-env": "^7.0.2",
    "eas-cli": "^16.32.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native": "^5.0.0",
    "typescript": "~5.9.2",
    "vitest": "^3.0.5"
  },
  "private": true,
  "packageManager": "yarn@1.22.22"
}
